# SlothDesk Environment Configuration

# Managed root directory (Downloads folder to organize)
# In native local dev, this can be a relative or absolute test folder:
SLOTHDESK_ROOT=./test_downloads
# In Podman container deployment, this is mounted to /data:
# SLOTHDESK_ROOT=/data

# Application metadata & manifest persistence directory
SLOTHDESK_DATA_DIR=./.slothdesk_data

# LM Studio Local Inference Configuration
# Native local host endpoint:
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Podman / Container host endpoint:
# LM_STUDIO_BASE_URL=http://host.containers.internal:1234/v1

# LM Studio loaded model identifier (check LM Studio > Developer tab / GET /v1/models)
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Plan expiration interval in seconds (default: 15 minutes)
PLAN_EXPIRY_SECONDS=900

# Backend server host & port
HOST=127.0.0.1
PORT=8000

# Frontend API URL (leave blank to use relative /api with Vite dev proxy)
VITE_API_BASE_URL=http://localhost:8000/api
