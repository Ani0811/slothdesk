# SlothDesk Backend Containerfile (Podman / Docker compatible)
FROM python:3.11-slim

# Security: Prevent Python from writing .pyc files to container root and unbuffer stdout
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SLOTHDESK_ROOT=/data \
    SLOTHDESK_DATA_DIR=/app/.slothdesk_data \
    LM_STUDIO_BASE_URL=http://host.containers.internal:1234/v1 \
    HOST=0.0.0.0 \
    PORT=8000

WORKDIR /app

# Install security updates and build requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -r slothgroup && useradd -r -g slothgroup -d /app -s /sbin/nologin slothuser

# Copy dependency specifications first to maximize layer cache
COPY pyproject.toml /app/

# Install dependencies using pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir .

# Copy application source code
COPY app/ /app/app/

# Create managed directories with appropriate ownership
RUN mkdir -p /data /app/.slothdesk_data && \
    chown -R slothuser:slothgroup /app /data

USER slothuser

EXPOSE 8000

# Health check verifying backend status
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
